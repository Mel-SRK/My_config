#!/usr/bin/env bash
set -euo pipefail
REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
apply=0
case "$#:${1:-}" in
  0:) ;;
  1:--apply) apply=1 ;;
  *) echo '用法：tool/mycfg-post [--apply]' >&2; exit 2 ;;
esac
steps=0

# Check both entry points before creating either of the paired tmux links.
tmux_links=()
tmux_blocked=0
for name in .tmux.conf .tmux.conf.local; do
  target="$HOME/.config/tmux/$name"
  link="$HOME/$name"
  if [[ -e "$link" || -L "$link" ]] &&
     [[ ! -L "$link" || "$(readlink -m -- "$link")" != "$(readlink -m -- "$target")" ]]; then
    printf '保留现有 tmux 入口 %q。请先备份并移走该路径，再运行 %q --apply。\n' "$link" "$REPO/tool/mycfg-post" >&2
    tmux_blocked=1
    continue
  fi
  if [[ "$apply" -eq 1 && ! -f "$target" ]]; then
    printf '缺少 tmux 配置文件 %q。请先运行 %q --apply。\n' "$target" "$REPO/install.sh" >&2
    tmux_blocked=1
    continue
  fi
  [[ -L "$link" ]] || tmux_links+=("$name")
done

units=0
while IFS=$'\t' read -r src dst mode desc extra || [[ -n "$src" ]]; do
  case "${src:-}" in ''|'#'*) continue ;; esac
  [[ "$mode" == user ]] || continue
  dst_exp="${dst/#\~/$HOME}"
  if [[ "$dst" == '~/.local/bin/'* || "$src" == *.sh ]]; then
    if [[ -f "$dst_exp" && ! -x "$dst_exp" ]]; then
      printf 'chmod +x %q\n' "$dst_exp"
      steps=$((steps+1))
      if [[ "$apply" -eq 1 ]]; then chmod +x -- "$dst_exp"; fi
    fi
  fi
  case "$dst_exp" in
    */.config/systemd/user/*.service)
      if [[ "$units" -eq 0 ]]; then echo 'systemctl --user daemon-reload'; fi
      printf 'systemctl --user enable --now %q\n' "${dst_exp##*/}"
      units=$((units+1))
      steps=$((steps+1))
      ;;
  esac
done < "$REPO/MANIFEST.tsv"

if [[ "$tmux_blocked" -eq 0 ]]; then
  for name in "${tmux_links[@]}"; do
    target="$HOME/.config/tmux/$name"
    link="$HOME/$name"
    printf 'ln -sT -- %q %q\n' "$target" "$link"
    steps=$((steps+1))
    if [[ "$apply" -eq 1 ]]; then ln -sT -- "$target" "$link"; fi
  done
fi

recent_files_key=(org.gnome.desktop.privacy remember-recent-files)
if recent_files_value=$(gsettings get "${recent_files_key[@]}" 2>/dev/null) && [[ "$recent_files_value" != false ]]; then
  printf 'gsettings set %s %s false\n' "${recent_files_key[@]}"
  steps=$((steps+1))
  if [[ "$apply" -eq 1 ]]; then
    if ! gsettings set "${recent_files_key[@]}" false || [[ "$(gsettings get "${recent_files_key[@]}")" != false ]]; then
      echo '未能关闭最近文件记录，请在用户图形会话中重试。' >&2
      exit 1
    fi
  fi
fi
if [[ "$steps" -eq 0 ]]; then echo '无后续步骤'; fi
echo 'niri msg action load-config-file'
echo '重新登录后 environment.d/ 才生效'
echo 'root 条目仍需按 install.sh 打印的 sudo 命令自己跑'
[[ "$apply" -eq 0 || "$tmux_blocked" -eq 0 ]]
