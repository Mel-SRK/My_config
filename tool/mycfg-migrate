#!/usr/bin/env bash
set -uo pipefail
REPO="${MYCONFIG_REPO:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}" || exit 1
STATE="${MYCONFIG_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/my_config/migrations}"
export LC_ALL=C

usage() {
  echo '用法：tool/mycfg-migrate [list|--pending|run [--apply]]' >&2
  exit 2
}
command_name="${1-list}"
apply=0
case "$command_name" in
  list|--pending) [[ $# -le 1 ]] || usage ;;
  run)
    if [[ $# -eq 2 && "$2" == --apply ]]; then
      apply=1
    elif [[ $# -ne 1 ]]; then
      usage
    fi
    ;;
  *) usage ;;
esac

marker_tmp=''
if [[ "$apply" -eq 1 ]]; then
  mkdir -p -- "$STATE" || exit 1
  # Lock before collecting pending work, so an overlapping runner cannot use
  # a stale pending list or execute the same migration twice.
  if ! mkdir -- "$STATE/.lock"; then
    echo "迁移锁不可用：$STATE/.lock（若进程已被强制终止，请确认后手动清理）" >&2
    exit 1
  fi
  cleanup() {
    [[ -z "$marker_tmp" ]] || rm -f -- "$marker_tmp"
    rmdir -- "$STATE/.lock"
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi

pending=()
shopt -s nullglob
for file in "$REPO"/migrations/*.sh; do
  [[ -e "$STATE/${file##*/}" ]] || pending+=("$file")
done
if [[ "$command_name" != run ]]; then
  [[ ${#pending[@]} -gt 0 ]] || exit 3
  for file in "${pending[@]}"; do printf '%s\n' "${file##*/}"; done
  exit 0
fi
if [[ "$apply" -eq 0 ]]; then
  printf '待执行 %s 条\n' "${#pending[@]}"
  for file in "${pending[@]}"; do printf '%s\n' "${file##*/}"; done
  exit 0
fi

for file in "${pending[@]}"; do
  name="${file##*/}"
  printf '==> %s\n' "$name"
  if (cd "$REPO" && MYCONFIG_REPO="$REPO" bash -euo pipefail "$file"); then
    if marker_tmp=$(mktemp -- "$STATE/.marker.XXXXXX") &&
       date -Is > "$marker_tmp" && mv -T -- "$marker_tmp" "$STATE/$name"; then
      marker_tmp=''
      continue
    fi
  fi
  printf '失败，已停在 %s，后续迁移未执行\n' "$name" >&2
  exit 1
done
exit 0
