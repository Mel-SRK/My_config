[core]
	pager = "if command -v delta >/dev/null 2>&1; then \
	    exec delta --side-by-side=120; \
	elif [ -x \"$HOME/.local/bin/delta\" ]; then \
	    exec \"$HOME/.local/bin/delta\" --side-by-side=120; \
	else \
	    exec cat; \
	fi"
[delta]
	navigate = true
	line-numbers = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	name = Mel-SRK
	email = 63025838+Mel-SRK@users.noreply.github.com
[http]
	proxy = socks5://127.0.0.1:7897
[https]
	proxy = socks5://127.0.0.1:7897
