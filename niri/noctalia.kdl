layout {

    focus-ring {
        active-color   "#58a6ff"
        inactive-color "#010409"
        urgent-color   "#f85149"
    }

    border {
        active-color   "#58a6ff"
        inactive-color "#010409"
        urgent-color   "#f85149"
    }


    tab-indicator {
        active-color   "#58a6ff"
        inactive-color "#1b3452"
        urgent-color   "#f85149"
    }

    insert-hint {
        color "#58a6ff80"
    }
}

recent-windows {
    highlight {
        active-color "#58a6ff"
        urgent-color "#f85149"
    }
}
