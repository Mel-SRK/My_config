[Unit]
Description=Sync micmute LED with PipeWire mute state
Wants=pipewire-pulse.socket
After=pipewire.service pipewire-pulse.socket
PartOf=pipewire.service
# Prevent crash loops: max 3 restarts in 60s
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/micmute-led-sync.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
